{
	"name": "cloudflare-blog",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "remix vite:build",
		"build:data": "tsx scripts/publish.ts",
		"deploy": "pnpm build && wrangler pages deploy ./build/client && pnpm build:data",
		"deploy:images": "tsx scripts/aws-image-upload.ts",
		"dev": "remix vite:dev",
		"lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
		"start": "wrangler pages dev ./build/client --kv=POSTS",
		"typecheck": "tsc",
		"test": "vitest",
		"test:e2e": "playwright test",
		"playwright": "playwright test --ui",
		"typegen": "wrangler types"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.679.0",
		"@r4ai/remark-callout": "^0.6.2",
		"@radix-ui/react-collapsible": "^1.1.1",
		"@radix-ui/react-icons": "^1.3.0",
		"@radix-ui/react-separator": "^1.1.0",
		"@radix-ui/react-slot": "^1.1.0",
		"@remix-run/cloudflare": "^2.13.1",
		"@remix-run/cloudflare-pages": "^2.13.1",
		"@remix-run/react": "^2.13.1",
		"@shikijs/rehype": "^1.22.2",
		"aws-sdk": "^2.1691.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"embla-carousel-react": "^8.3.1",
		"gray-matter": "^4.0.3",
		"isbot": "^5.1.17",
		"miniflare": "^3.20241022.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tiny-invariant": "^1.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@cloudflare/workers-types": "^4.20241022.0",
		"@playwright/test": "^1.48.2",
		"@remix-run/dev": "^2.13.1",
		"@remix-run/testing": "^2.13.1",
		"@tailwindcss/typography": "^0.5.15",
		"@testing-library/jest-dom": "^6.6.2",
		"@testing-library/react": "^16.0.1",
		"@testing-library/user-event": "^14.5.2",
		"@types/node": "^22.8.4",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"autoprefixer": "^10.4.20",
		"cloudflare": "^3.5.0",
		"dotenv": "^16.4.5",
		"node-fetch": "^3.3.2",
		"postcss": "^8.4.47",
		"rehype-stringify": "^10.0.1",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.0",
		"remark-html": "^16.0.1",
		"remark-parse": "^11.0.0",
		"remark-prism": "^1.3.6",
		"remark-rehype": "^11.1.1",
		"remark-stringify": "^11.0.0",
		"sharp": "^0.33.5",
		"tailwindcss": "^3.4.14",
		"tailwindcss-animate": "^1.0.7",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3",
		"unified": "^11.0.5",
		"vite": "^5.4.10",
		"vite-tsconfig-paths": "^5.0.1",
		"vitest": "^2.1.4",
		"wrangler": "^3.83.0"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
